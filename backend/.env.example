# Classmate AI backend configuration (NOT your personal keys — those go in the
# web Settings so every user provides their own).
CLASSMATE_SECRET_KEY=change-me-to-a-long-random-string
CLASSMATE_PORT=8000
CLASSMATE_LLM_MODEL=openai/gpt-oss-20b
# Optional: override database / chroma / cors
# CLASSMATE_DATABASE_URL=sqlite:///data/classmate.db
# CLASSMATE_CORS_ORIGINS=http://localhost:5173