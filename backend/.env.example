# Classmate AI backend configuration (NOT your personal keys — those go in the
# web Settings so every user provides their own).

# REQUIRED. Use a long random string, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`
CLASSMATE_SECRET_KEY=change-me-to-a-long-random-string

CLASSMATE_PORT=8000
CLASSMATE_LLM_MODEL=openai/gpt-oss-20b

# Data lives under CLASSMATE_DATA_DIR (SQLite DB + Chroma). Point this at a
# PERSISTENT volume in production (see docker-compose.yml: cmx-data:/app/backend/data).
# CLASSMATE_DATA_DIR=./data

# Optional: pass a Google Client ID to enable "Continue with Google". The same
# value is baked into the frontend at build time via VITE_GOOGLE_CLIENT_ID.
# GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
# VITE_GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com

# Optional overrides
# CLASSMATE_DATABASE_URL=sqlite:///data/classmate.db
# CLASSMATE_CORS_ORIGINS=http://localhost:5173
